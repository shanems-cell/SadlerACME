[Unit]
Description=SadlerACME worker

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
# build-spk.sh expands this into a root-private, SHA-256 verified snapshot.
ExecStart=@VERIFIED_WORKER@ worker
Slice=sadleracme.slice
TimeoutStartSec=45min
TimeoutStopSec=30s
KillMode=control-group
NoNewPrivileges=true
